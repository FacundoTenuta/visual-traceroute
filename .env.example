# Copy to .env and fill in what you need. Every variable is optional.
# Never commit .env: it is git-ignored.

# Globalping API token for remote traces. Without it, every visitor of a
# deployment shares Globalping's anonymous limit (250 tests per hour per IP).
# Get one at https://dash.globalping.io
GLOBALPING_TOKEN=

# ip-api Pro key. When set, lookups use https://pro.ip-api.com; without it the
# free HTTP endpoint is used (non-commercial use only, 45 requests per minute).
IPAPI_KEY=

# Remote traces each visitor may start per sliding hour (default 10).
REMOTE_TRACES_PER_HOUR=

# Set to 0 to turn off traces from this computer. They are offered
# automatically when traceroute is found on the PATH.
TRACE_LOCAL=

# Set to 1 only behind a proxy that overwrites X-Forwarded-For (Vercel does).
# Enables the per-visitor limits; otherwise forwarding headers are ignored.
TRUST_PROXY=